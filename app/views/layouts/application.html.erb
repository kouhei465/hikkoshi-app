<!DOCTYPE html>
<html>
  <head>
    <% if Rails.env.production? %>
      <!-- Google tag (gtag.js) -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-ELMP38K018"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-ELMP38K018');
      </script>
    <% end %>

    <title><%= content_for(:title).presence || "引っ越し費用まとめ帳" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <div class="d-flex flex-column min-vh-100">
      <%= render "shared/header" %>

      <%# flashの種類に応じてBootstrapの表示色を切り替える %>
      <% flash.each do |message_type, message| %>
        <% bootstrap_class =
          case message_type.to_sym
          when :notice
            "alert-success"
          when :alert
            "alert-danger"
          else
            "alert-info"
          end
        %>

        <div class="container mt-3">
          <div class="alert <%= bootstrap_class %>">
            <%= message %>
          </div>
        </div>
      <% end %>

      <%= yield %>
      <%= render "shared/footer" %>
    </div>
  </body>
</html>
