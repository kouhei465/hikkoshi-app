<main class="flex-grow-1 d-flex flex-column justify-content-center align-items-center pb-5">
  <div class="col-4">
    <p class="text-center mb-3">登録したメールアドレスを入力してください</p>

    <%= form_with url: password_resets_path do |f| %>
      <%= f.email_field :email, placeholder: "メールアドレス", class: "form-control mb-3" %>

      <div class="text-center"><%= f.submit "再設定メールを送信", class: "btn btn-primary" %></div>
    <% end %>

    <div class="text-center mt-4"><%= link_to "ログイン画面に戻る", login_path %></div>
  </div>
</main>
