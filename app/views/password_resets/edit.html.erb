<main class="flex-grow-1 d-flex flex-column justify-content-center align-items-center pb-5">
  <div class="col-4">
    <%# 入力内容にエラーがある場合は一覧で表示 %>
    <% if @user.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: password_reset_path(@token), method: :patch do |f| %>
      <%= f.password_field :password, placeholder: "新しいパスワード", class: "form-control mb-3" %>
      <%= f.password_field :password_confirmation, placeholder: "新しいパスワード（確認用）", class: "form-control mb-3" %>

      <div class="text-center"><%= f.submit "パスワードを再設定", class: "btn btn-primary" %></div>
    <% end %>
  </div>
</main>
