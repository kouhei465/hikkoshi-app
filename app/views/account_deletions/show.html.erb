<main class="container py-4 py-md-5">
  <div class="col-12 col-md-9 col-lg-7 mx-auto">
    <h2 class="mb-4 text-danger">アカウントの削除</h2>

    <div class="border border-danger rounded p-3 p-md-4">
      <p class="fw-bold text-danger">退会する前に、以下のすべての項目を確認してください。</p>

      <%= form_with url: account_deletion_path,
                    method: :delete,
                    scope: :account_deletion,
                    data: {
                      controller: "account-deletion",
                      account_deletion_password_required_value: @password_required
                    } do |f| %>
        <fieldset class="mb-3">
          <legend class="h6">削除内容の確認</legend>
          <% confirmation_items = {
            user_information_confirmed: "ユーザー登録情報が削除されることを確認しました",
            google_authentication_confirmed: "Google連携情報が削除されることを確認しました",
            cost_data_confirmed: "保存済みの費用リストと費用項目が削除されることを確認しました",
            irreversible_confirmed: "削除した情報は元に戻せないことを確認しました"
          } %>
          <% confirmation_items.each do |field, label| %>
            <div class="form-check mb-2">
              <%= f.check_box field,
                              {
                                checked: @confirmations[field],
                                class: "form-check-input",
                                data: {
                                  account_deletion_target: "confirmation",
                                  action: "change->account-deletion#updateSubmitState"
                                }
                              },
                              "true",
                              "false" %>
              <%= f.label field, label, class: "form-check-label" %>
            </div>
          <% end %>
        </fieldset>

        <div class="alert alert-warning small" role="note">
          Googleログインを利用している場合も、Googleアカウント自体は削除されません。
        </div>
        <p>同じメールアドレスで再登録しても、過去のデータは復元されません。</p>

        <% if @password_required %>
          <div class="mb-4">
            <%= f.label :current_password, "現在のパスワード", class: "form-label" %>
            <%= f.password_field :current_password,
                                 value: nil,
                                 autocomplete: "current-password",
                                 class: "form-control",
                                 data: {
                                   account_deletion_target: "password",
                                   action: "input->account-deletion#updateSubmitState"
                                 } %>
          </div>
        <% end %>

        <div class="d-grid gap-2 d-sm-flex">
          <%= f.button "アカウントを削除する",
                       type: "submit",
                       class: "btn btn-danger",
                       disabled: true,
                       data: {
                         account_deletion_target: "submit",
                         turbo_submits_with: "削除中…"
                       } %>
          <%= link_to "マイページに戻る", mypage_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</main>
